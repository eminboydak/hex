---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getPublishedPosts } from '@/lib/db';

const posts = await getPublishedPosts(env.DB);
---
<BaseLayout title="hex — yazılar">
  <section>
    <h1 class="font-display text-3xl text-ink">Yazılar</h1>
    {
      posts.length === 0 ? (
        <p class="mt-6 font-mono text-sm text-faint">
          Henüz yayınlanmış yazı yok.
        </p>
      ) : (
        <div class="mt-6">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
