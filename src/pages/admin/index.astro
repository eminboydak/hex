---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Post } from '@/lib/types';

// Fetch posts from API
const response = await fetch(`${import.meta.env.SITE_URL || 'http://localhost:4321'}/api/admin/posts`);
const data = await response.json() as { posts: Post[] };
const posts: Post[] = data.posts || [];

const formatDate = (dateString: string | null) => {
  if (!dateString) return null;
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<BaseLayout title="Admin Panel">
  <div class="max-w-4xl">
    <h1 class="font-display text-3xl text-ink mb-8">Admin Panel</h1>

    <div class="mb-6">
      <a
        href="/admin/editor"
        class="inline-block px-4 py-2 border border-color rounded text-ink hover:bg-surface transition-colors"
      >
        + New Post
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-faint">No posts yet. Create your first post!</p>
    ) : (
      <div class="border border-color rounded overflow-hidden">
        <table class="w-full">
          <thead class="border-b border-line bg-surface">
            <tr>
              <th class="text-left px-4 py-3 font-mono text-xs text-faint">Title</th>
              <th class="text-left px-4 py-3 font-mono text-xs text-faint">Status</th>
              <th class="text-left px-4 py-3 font-mono text-xs text-faint">Created</th>
              <th class="text-left px-4 py-3 font-mono text-xs text-faint">Published</th>
              <th class="text-right px-4 py-3 font-mono text-xs text-faint">Actions</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr class="border-b border-line hover:bg-surface transition-colors">
                <td class="px-4 py-3">
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-ink hover:text-mauve transition-colors block"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {post.title}
                  </a>
                </td>
                <td class="px-4 py-3">
                  <span
                    class={`inline-block px-2 py-1 rounded text-xs font-mono ${
                      post.status === 'published'
                        ? 'bg-mauve/20 text-mauve'
                        : 'bg-peach/20 text-peach'
                    }`}
                  >
                    {post.status}
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-faint">
                  {formatDate(post.created_at)}
                </td>
                <td class="px-4 py-3 font-mono text-xs text-faint">
                  {formatDate(post.published_at) || '-'}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/admin/editor?id=${post.id}`}
                      class="px-2 py-1 text-xs border border-color rounded hover:bg-surface transition-colors"
                    >
                      Edit
                    </a>
                    <button
                      onclick={`if (confirm('Delete this post?')) { fetch('/api/admin/posts/${post.id}', { method: 'DELETE' }).then(() => location.reload()).catch(e => console.error(e)); }`}
                      class="px-2 py-1 text-xs border border-color rounded hover:bg-surface hover:text-red-500 transition-colors"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>