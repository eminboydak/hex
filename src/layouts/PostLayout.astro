---
import BaseLayout from './BaseLayout.astro';
import type { Post } from '@/lib/types';

interface Props {
  post: Post;
}
const { post } = Astro.props;

const date = post.published_at
  ? new Date(post.published_at).toLocaleDateString('tr-TR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---
<BaseLayout title={post.title} description={post.excerpt ?? undefined}>
  <article>
    <header class="mb-10 border-b border-line pb-6">
      <h1 class="font-display text-4xl leading-tight text-ink md:text-5xl">
        {post.title}
      </h1>
      {
        date && (
          <time
            class="mt-3 block font-mono text-xs text-faint"
            datetime={post.published_at ?? undefined}
          >
            {date}
          </time>
        )
      }
    </header>

    <div
      class="prose prose-invert max-w-none prose-headings:font-display prose-a:text-mauve prose-a:no-underline hover:prose-a:underline prose-strong:text-ink prose-code:rounded prose-code:bg-panel prose-code:px-1.5 prose-code:py-0.5 prose-code:text-peach prose-code:before:content-[''] prose-code:after:content-['']"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
