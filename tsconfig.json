{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/lib/*": ["src/lib/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "preact"
  },
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "**/*.ts", "**/*.astro"],
  "exclude": ["dist"]
}
